---
const audiences = [
  {
    number: '01',
    label: 'Residencial',
    title: 'Sua casa, do projeto ao acabamento',
    description: 'Materiais elétricos e iluminação para construir, reformar e renovar ambientes com segurança.',
    href: '/solucoes#residenciais',
    link: 'Soluções residenciais',
  },
  {
    number: '02',
    label: 'Profissionais',
    title: 'Agilidade para quem vive a obra',
    description: 'Atendimento de balcão para eletricistas e profissionais que precisam decidir e avançar.',
    href: '/solucoes#atendimento-balcao',
    link: 'Atendimento profissional',
  },
  {
    number: '03',
    label: 'Empresas',
    title: 'Suprimentos para operações exigentes',
    description: 'Materiais para demandas comerciais e industriais, com orientação próxima da nossa equipe.',
    href: '/solucoes#comerciais',
    link: 'Soluções empresariais',
  },
];
---

<section class="bg-[var(--color-paper)] py-20 sm:py-24 lg:py-28">
  <div class="container-shell">
    <div class="grid gap-8 border-b border-slate-300 pb-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-4">Atendimento sob medida</p>
        <h2 class="section-title max-w-3xl">Uma loja preparada para diferentes desafios</h2>
      </div>
      <p class="text-lg leading-relaxed text-slate-600 lg:col-span-5 lg:pl-8">
        Da escolha de um acabamento à conferência de uma lista técnica, você encontra orientação e materiais para seguir com confiança.
      </p>
    </div>

    <div class="mt-10 grid gap-px overflow-hidden border border-slate-200 bg-slate-200 lg:grid-cols-3">
      {audiences.map((item, index) => (
        <article class="group relative flex min-h-[360px] flex-col bg-white p-7 sm:p-9">
          <div class="flex items-start justify-between">
            <span class="font-heading text-5xl font-extrabold text-slate-500 transition-colors group-hover:text-cinetica-orange" aria-hidden="true">{item.number}</span>
            <span class="border border-slate-200 px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-cinetica-blue-navy">{item.label}</span>
          </div>
          <div class="mt-auto pt-16">
            <h3 class="max-w-sm font-heading text-3xl font-extrabold uppercase leading-none text-cinetica-blue-deep sm:text-4xl">{item.title}</h3>
            <p class="mt-5 text-base leading-relaxed text-slate-600">{item.description}</p>
            <a href={item.href} class="mt-7 inline-flex border-b-2 border-cinetica-orange pb-1 text-sm font-extrabold uppercase tracking-[0.08em] text-cinetica-blue-deep transition-colors hover:text-cinetica-orange focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cinetica-orange">
              {item.link}
            </a>
          </div>
          {index === 1 && <div class="absolute inset-x-0 top-0 h-1 bg-cinetica-blue-electric" aria-hidden="true"></div>}
        </article>
      ))}
    </div>
  </div>
</section>
