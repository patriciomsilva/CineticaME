---
import { siteInfo } from '../data/siteInfo';
---

<section class="relative bg-cinetica-blue-dark text-white overflow-hidden border-b border-cinetica-blue-navy/50">
  
  <!-- Grid Principal Dividido (Desktop) / Empilhado (Mobile) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Coluna Esquerda: Conteúdo Textual e Ações -->
      <div class="lg:col-span-6 xl:col-span-7 flex flex-col justify-center z-10">
        
        <!-- Indicador de Origem Técnica / Localização -->
        <div class="inline-flex items-center gap-2 bg-cinetica-blue-navy/90 border border-cinetica-blue-electric/40 px-3.5 py-1.5 rounded text-xs font-semibold tracking-wider text-cinetica-blue-light uppercase mb-6 w-fit shadow-sm">
          <span class="w-2 h-2 rounded-full bg-cinetica-orange animate-pulse" aria-hidden="true"></span>
          <span>{siteInfo.locationDisplay}</span>
        </div>

        <!-- Título Confirmado com Destaque em Laranja -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.05] mb-5 font-heading text-white">
          SOLUÇÕES COMPLETAS EM <span class="text-cinetica-orange">MATERIAIS ELÉTRICOS</span>
        </h1>

        <!-- Linha Técnica de Apoio Inspirada no Raio -->
        <div class="w-20 h-1 bg-gradient-to-r from-cinetica-orange to-cinetica-blue-electric mb-6 rounded-full"></div>

        <!-- Texto Confirmado -->
        <p class="text-base sm:text-lg text-slate-200 mb-8 font-sans font-normal leading-relaxed max-w-xl">
          Atendimento para necessidades residenciais, comerciais e industriais em Morro da Fumaça.
        </p>

        <!-- Ações Confirmadas com Alto Contraste -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4">
          <a
            href="/contato"
            class="bg-cinetica-orange hover:bg-cinetica-orange-hover text-cinetica-blue-dark hover:text-black font-extrabold uppercase tracking-wider text-sm px-7 py-4 rounded shadow-md transition-all text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white flex items-center justify-center gap-2 group"
          >
            <span>Fale com a Cinética</span>
            <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>

          <a
            href="/solucoes"
            class="bg-cinetica-blue-navy/80 hover:bg-cinetica-blue-navy border border-slate-600 hover:border-slate-400 text-white font-bold uppercase tracking-wider text-sm px-6 py-4 rounded transition-all text-center flex items-center justify-center gap-2.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cinetica-orange"
          >
            <span>Conhecer Soluções</span>
          </a>
        </div>

      </div>

      <!-- Coluna Direita: Fotografia Real da Equipe com Clareza Total -->
      <div class="lg:col-span-6 xl:col-span-5 relative">
        <!-- Moldura Geométrica com Linhas Técnicas Diagonais -->
        <div class="relative rounded-lg overflow-hidden border-2 border-cinetica-blue-navy shadow-2xl bg-cinetica-blue-deep group">
          
          <!-- Imagem Real da Equipe Preservando Rostos e Proporção -->
          <picture>
            <source media="(max-width: 640px)" srcset="/assets/images/equipe-hero-sm.avif" type="image/avif" />
            <source media="(max-width: 640px)" srcset="/assets/images/equipe-hero-sm.webp" type="image/webp" />
            <source srcset="/assets/images/equipe-hero.avif" type="image/avif" />
            <source srcset="/assets/images/equipe-hero.webp" type="image/webp" />
            <img
              src="/assets/images/equipe-hero.webp"
              alt="Equipe da Cinética Materiais Elétricos em Morro da Fumaça"
              width="1200"
              height="800"
              class="w-full h-auto aspect-[3/2] object-cover object-center transform transition-transform duration-500 group-hover:scale-[1.02]"
              fetchpriority="high"
            />
          </picture>

          <!-- Acento Angular no Canto Superior Direito -->
          <div class="absolute top-0 right-0 w-8 h-8 pointer-events-none overflow-hidden" aria-hidden="true">
            <div class="absolute top-0 right-0 w-0 h-0 border-t-[32px] border-t-cinetica-orange border-l-[32px] border-l-transparent"></div>
          </div>
        </div>

        <!-- Linha Decorativa Técnica de Apoio -->
        <div class="hidden lg:block absolute -bottom-3 -left-3 -right-3 h-[2px] bg-gradient-to-r from-cinetica-orange via-cinetica-blue-electric to-transparent pointer-events-none" aria-hidden="true"></div>
      </div>

    </div>
  </div>
</section>
