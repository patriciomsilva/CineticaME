---
import { siteInfo } from '../data/siteInfo';
---

<section class="relative isolate overflow-hidden bg-cinetica-blue-dark text-white">
  <div class="absolute inset-0 opacity-70" aria-hidden="true">
    <div class="absolute -left-40 top-10 h-96 w-96 rounded-full bg-cinetica-blue-electric/10 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-px w-2/3 bg-gradient-to-r from-transparent via-cinetica-blue-electric/40 to-cinetica-orange"></div>
  </div>

  <div class="container-shell relative py-10 sm:py-14 lg:py-20">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7 lg:pr-8">
        <p class="eyebrow eyebrow-dark mb-7">{siteInfo.locationDisplay}</p>
        <h1 class="display-title max-w-4xl text-white">
          Energia para cada projeto.
          <span class="block text-cinetica-orange">Material para fazer acontecer.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-300 sm:text-xl">
          Materiais elétricos, iluminação e atendimento próximo para residências, profissionais e empresas em Morro da Fumaça.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/contato" class="btn-primary">Falar com a Cinética</a>
          <a href="/solucoes" class="btn-secondary border-white/30 bg-transparent text-white hover:border-white hover:bg-white hover:text-cinetica-blue-dark">Explorar soluções</a>
        </div>
        <ul class="mt-10 grid max-w-2xl grid-cols-3 divide-x divide-white/15 border-y border-white/15 py-4 text-sm text-slate-300" aria-label="Segmentos atendidos">
          <li class="pr-4"><strong class="block font-heading text-xl uppercase text-white">Residencial</strong>Construção e reforma</li>
          <li class="px-4"><strong class="block font-heading text-xl uppercase text-white">Profissional</strong>Rotina de obra</li>
          <li class="pl-4"><strong class="block font-heading text-xl uppercase text-white">Empresas</strong>Comércio e indústria</li>
        </ul>
      </div>

      <div class="relative lg:col-span-5 lg:pl-4">
        <div class="absolute -left-5 -top-5 hidden h-28 w-28 border-l border-t border-cinetica-orange/70 lg:block" aria-hidden="true"></div>
        <figure class="image-frame aspect-[4/5] shadow-2xl sm:aspect-[5/4] lg:aspect-[4/5]">
          <picture>
            <source media="(max-width: 640px)" srcset="/assets/images/equipe-hero-sm.avif" type="image/avif" />
            <source media="(max-width: 640px)" srcset="/assets/images/equipe-hero-sm.webp" type="image/webp" />
            <source srcset="/assets/images/equipe-hero.avif" type="image/avif" />
            <source srcset="/assets/images/equipe-hero.webp" type="image/webp" />
            <img src="/assets/images/equipe-hero.webp" alt="Equipe da Cinética Materiais Elétricos em Morro da Fumaça" width="1200" height="800" class="h-full w-full object-cover object-center" fetchpriority="high" />
          </picture>
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-cinetica-blue-dark via-cinetica-blue-dark/75 to-transparent px-6 pb-6 pt-20">
            <span class="font-heading text-2xl font-bold uppercase tracking-wide text-white">Atendimento que entende o seu projeto</span>
          </figcaption>
        </figure>
        <div class="absolute -bottom-4 -right-4 hidden bg-cinetica-orange px-5 py-4 text-cinetica-blue-dark shadow-xl sm:block">
          <span class="block font-heading text-2xl font-extrabold uppercase leading-none">Presença local</span>
          <span class="text-xs font-bold uppercase tracking-wider">Morro da Fumaça — SC</span>
        </div>
      </div>
    </div>
  </div>
</section>
