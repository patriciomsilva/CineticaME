<section class="overflow-hidden bg-white pt-16 pb-12 sm:pt-20 sm:pb-14 lg:pt-24 lg:pb-16">
  <div class="container-shell">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
