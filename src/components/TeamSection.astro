          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-cinetica-blue-dark/90 via-cinetica-blue-dark/40 to-transparent p-5 pt-12">
            <span class="block font-heading text-xl font-bold uppercase text-white">Equipe Cinética</span>
          </figcaption>
