<section class="bg-cinetica-orange py-10 sm:py-12 text-cinetica-blue-dark">
  <div class="container-shell flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
    <div class="max-w-2xl">
      <p class="font-sans text-xs font-bold uppercase tracking-[0.16em] text-cinetica-blue-dark/85">Seu projeto começa com uma boa conversa</p>
      <h2 class="mt-1 font-heading text-2xl font-extrabold uppercase leading-tight sm:text-3xl lg:text-4xl text-cinetica-blue-dark">
        Conte o que você precisa. A equipe ajuda a encontrar o caminho.
      </h2>
    </div>
    <a
      href="/contato"
      class="inline-flex min-h-12 items-center justify-center rounded-sm bg-cinetica-blue-dark px-7 py-3 font-sans text-sm font-bold uppercase tracking-[0.06em] text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-cinetica-blue-navy hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cinetica-blue-dark focus-visible:ring-offset-2 shrink-0"
