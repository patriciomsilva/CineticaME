</section>

<section class="bg-cinetica-orange py-10 text-cinetica-blue-dark">
  <div class="container-shell flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em]">Seu projeto começa com uma boa conversa</p>
      <h2 class="mt-1 font-heading text-3xl font-extrabold uppercase leading-none sm:text-4xl">Conte o que você precisa. A equipe ajuda a encontrar o caminho.</h2>
    </div>
    <a href="/contato" class="btn-secondary shrink-0 border-cinetica-blue-dark">Entrar em contato</a>
  </div>
</section>
