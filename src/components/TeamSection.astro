<section class="overflow-hidden bg-white py-20 sm:py-24 lg:py-28">
  <div class="container-shell">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-4 lg:sticky lg:top-28">
        <p class="eyebrow mb-4">Presença de verdade</p>
        <h2 class="section-title">Estrutura que aproxima. Equipe que resolve.</h2>
        <p class="mt-6 text-lg leading-relaxed text-slate-600">
          Uma loja física feita para ver, comparar e conversar. Nossa equipe recebe cada necessidade de perto, no balcão e no showroom.
        </p>
        <a href="/a-cinetica" class="btn-secondary mt-8">Conhecer a Cinética</a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:col-span-8">
        <figure class="image-frame group min-h-[520px] sm:col-span-2">
          <picture>
            <source srcset="/assets/images/equipe-institucional.avif" type="image/avif" />
            <source srcset="/assets/images/equipe-institucional.webp" type="image/webp" />
            <img src="/assets/images/equipe-institucional.webp" alt="Equipe da Cinética Materiais Elétricos reunida na loja" width="1000" height="667" loading="lazy" decoding="async" class="h-full w-full object-cover object-center transition duration-700 group-hover:scale-[1.02]" />
          </picture>
          <figcaption class="absolute bottom-0 left-0 max-w-sm bg-white p-6 sm:p-8">
            <span class="eyebrow mb-3">Nossa equipe</span>
            <strong class="block font-heading text-3xl font-extrabold uppercase leading-none text-cinetica-blue-deep">Atendimento próximo começa com pessoas presentes</strong>
          </figcaption>
        </figure>

        <figure class="image-frame group aspect-[4/5]">
          <picture>
            <source srcset="/assets/images/showroom-iluminacao.avif" type="image/avif" />
            <source srcset="/assets/images/showroom-iluminacao.webp" type="image/webp" />
            <img src="/assets/images/showroom-iluminacao.webp" alt="Integrante da equipe Cinética Materiais Elétricos" width="700" height="875" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" />
          </picture>
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-cinetica-blue-dark to-transparent p-6 pt-20 font-heading text-2xl font-bold uppercase text-white">Equipe preparada para receber</figcaption>
        </figure>

        <figure class="image-frame group aspect-[4/5]">
          <picture>
            <source srcset="/assets/images/estoque-estrutura.avif" type="image/avif" />
            <source srcset="/assets/images/estoque-estrutura.webp" type="image/webp" />
            <img src="/assets/images/estoque-estrutura.webp" alt="Integrante da equipe Cinética Materiais Elétricos" width="700" height="875" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" />
          </picture>
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-cinetica-blue-dark to-transparent p-6 pt-20 font-heading text-2xl font-bold uppercase text-white">Atendimento próximo e humano</figcaption>
        </figure>
      </div>
    </div>
