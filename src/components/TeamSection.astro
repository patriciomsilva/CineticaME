        </p>
        <a href="/a-cinetica" class="btn-secondary mt-8">Conhecer a Cinética</a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
        <figure class="image-frame group aspect-[16/10] sm:col-span-2">
