---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="A Cinética — Loja e Atendimento em Morro da Fumaça - SC"
  description="Conheça a Cinética Materiais Elétricos: espaço físico em Morro da Fumaça — SC, equipe e atendimento no balcão."
>
  <!-- Hero Institucional -->
  <section class="bg-cinetica-blue-deep text-white py-16 sm:py-20 relative overflow-hidden border-b border-cinetica-blue-navy/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-cinetica-blue-navy border border-cinetica-blue-electric/40 px-3.5 py-1.5 rounded text-xs font-semibold tracking-wider text-cinetica-blue-light uppercase mb-4 w-fit">
          <span class="w-2 h-2 rounded-full bg-cinetica-orange" aria-hidden="true"></span>
          <span>Presença Física e Equipe</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold font-heading mb-4 text-white tracking-tight">
          A Cinética <span class="text-cinetica-orange">Materiais Elétricos</span>
        </h1>
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed font-sans">
          Espaço físico, balcão de materiais e equipe pronta para atender você em Morro da Fumaça — SC.
        </p>
      </div>
    </div>
  </section>

  <!-- Seção Institucional: Proposta e Equipe Real -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20">
        
        <div class="lg:col-span-6 space-y-6">
          <span class="text-orange-800 font-bold uppercase tracking-wider text-xs block font-heading">
            Atendimento Presencial
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-cinetica-blue-deep font-heading tracking-tight">
            Estrutura e Atendimento Presencial
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-sans">
            A <strong>Cinética Materiais Elétricos</strong> atua em Morro da Fumaça — SC como loja física para atender clientes residenciais, profissionais da área elétrica e empresas.
          </p>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-sans">
            Nossa estrutura conta com espaço físico para exposição de iluminação, balcão de atendimento para conferência de materiais elétricos e equipe para recepção presencial.
          </p>
          <div class="pt-2">
            <a
              href="/contato"
              class="inline-flex items-center gap-2 bg-cinetica-orange hover:bg-cinetica-orange-hover text-cinetica-blue-dark font-extrabold text-xs uppercase tracking-wider px-6 py-3.5 rounded shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cinetica-orange"
            >
              <span>Fale com Nossa Equipe</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- Foto Real da Equipe com Moldura Segura -->
        <div class="lg:col-span-6">
          <div class="rounded-xl overflow-hidden shadow-lg border border-slate-200 aspect-[4/3] bg-slate-900 relative">
            <picture>
              <source media="(max-width: 640px)" srcset="/assets/images/equipe-institucional-sm.avif" type="image/avif" />
              <source media="(max-width: 640px)" srcset="/assets/images/equipe-institucional-sm.webp" type="image/webp" />
              <source srcset="/assets/images/equipe-institucional.avif" type="image/avif" />
              <source srcset="/assets/images/equipe-institucional.webp" type="image/webp" />
              <img
                src="/assets/images/equipe-institucional.webp"
                alt="Equipe da Cinética Materiais Elétricos reunida na loja em Morro da Fumaça"
                width="1000"
                height="667"
                class="w-full h-full object-cover object-center"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
        </div>

      </div>

      <!-- Estrutura Física, Mostruário e Showroom -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 sm:p-12">
        <div class="max-w-3xl mb-10">
          <span class="text-orange-800 font-bold uppercase tracking-wider text-xs block mb-1 font-heading">
            Espaço e Ambientes
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-cinetica-blue-deep font-heading tracking-tight">
            Showroom, Balcão e Loja Física
          </h2>
          <p class="text-slate-600 text-sm sm:text-base mt-2 font-sans">
            Visite nossa estrutura em Morro da Fumaça — SC para conferir de perto as opções de iluminação, acabamentos e materiais elétricos no balcão.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-lg overflow-hidden border border-slate-200 shadow-sm flex flex-col group">
            <div class="aspect-[4/3] overflow-hidden bg-slate-100 relative">
              <picture>
                <source media="(max-width: 640px)" srcset="/assets/images/loja-fachada-sm.avif" type="image/avif" />
                <source media="(max-width: 640px)" srcset="/assets/images/loja-fachada-sm.webp" type="image/webp" />
                <source srcset="/assets/images/loja-fachada.avif" type="image/avif" />
                <source srcset="/assets/images/loja-fachada.webp" type="image/webp" />
                <img
                  src="/assets/images/loja-fachada.webp"
                  alt="Fachada da loja física Cinética Materiais Elétricos em Morro da Fumaça"
                  width="700"
                  height="875"
                  class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="p-4 border-t border-slate-100">
              <h3 class="font-heading font-bold text-base text-cinetica-blue-deep">Estrutura e Fachada</h3>
              <p class="text-xs text-slate-600 font-sans mt-1">Loja física e ponto de atendimento em Morro da Fumaça — SC.</p>
            </div>
          </div>

          <div class="bg-white rounded-lg overflow-hidden border border-slate-200 shadow-sm flex flex-col group">
            <div class="aspect-[4/3] overflow-hidden bg-slate-100 relative">
              <picture>
                <source media="(max-width: 640px)" srcset="/assets/images/atendimento-balcao-sm.avif" type="image/avif" />
                <source media="(max-width: 640px)" srcset="/assets/images/atendimento-balcao-sm.webp" type="image/webp" />
                <source srcset="/assets/images/atendimento-balcao.avif" type="image/avif" />
                <source srcset="/assets/images/atendimento-balcao.webp" type="image/webp" />
                <img
                  src="/assets/images/atendimento-balcao.webp"
                  alt="Balcão de atendimento e conferência de materiais elétricos"
                  width="700"
                  height="875"
                  class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="p-4 border-t border-slate-100">
              <h3 class="font-heading font-bold text-base text-cinetica-blue-deep">Balcão de Atendimento</h3>
              <p class="text-xs text-slate-600 font-sans mt-1">Conferência de listas, mostruários e atendimento presencial.</p>
            </div>
          </div>

          <div class="bg-white rounded-lg overflow-hidden border border-slate-200 shadow-sm flex flex-col group">
            <div class="aspect-[4/3] overflow-hidden bg-slate-100 relative">
              <picture>
                <source media="(max-width: 640px)" srcset="/assets/images/equipe-hero-sm.avif" type="image/avif" />
                <source media="(max-width: 640px)" srcset="/assets/images/equipe-hero-sm.webp" type="image/webp" />
                <source srcset="/assets/images/equipe-hero.avif" type="image/avif" />
                <source srcset="/assets/images/equipe-hero.webp" type="image/webp" />
                <img
                  src="/assets/images/equipe-hero.webp"
                  alt="Equipe e recepção institucional na Cinética Materiais Elétricos"
                  width="700"
                  height="875"
                  class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="p-4 border-t border-slate-100">
              <h3 class="font-heading font-bold text-base text-cinetica-blue-deep">Equipe e Recepção</h3>
              <p class="text-xs text-slate-600 font-sans mt-1">Equipe presencial para recepção de clientes no espaço físico.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>


