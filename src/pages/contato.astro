---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteInfo } from '../data/siteInfo';
---

<BaseLayout
  title="Contato — Cinética Materiais Elétricos"
  description="Entre em contato com a Cinética Materiais Elétricos em Morro da Fumaça - SC."
>
  <section class="bg-cinetica-blue-deep text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="text-cinetica-orange font-bold uppercase tracking-wider text-xs block mb-2">Atendimento</span>
        <h1 class="text-4xl sm:text-6xl font-extrabold font-heading mb-4 text-white">
          Fale com a Cinética
        </h1>
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed">
          Atendimento institucional e informações em Morro da Fumaça — SC.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white rounded-xl border border-slate-200 p-8 sm:p-12 shadow-sm space-y-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-cinetica-blue-deep font-heading mb-3">
            Canal Oficial de Atendimento
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Acompanhe nossas novidades e envie mensagens através do nosso canal oficial no Instagram:
          </p>
        </div>

        <div class="p-6 bg-cinetica-light rounded-lg border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-cinetica-blue-deep flex items-center justify-center text-white shrink-0">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs uppercase font-bold text-slate-500 block">Instagram Oficial</span>
              <span class="text-lg font-bold text-cinetica-blue-deep">{siteInfo.contact.instagram}</span>
            </div>
          </div>
          <a
            href={siteInfo.contact.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-cinetica-orange hover:bg-cinetica-orange-hover text-white text-xs font-bold uppercase tracking-wider px-5 py-2.5 rounded transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cinetica-orange"
            aria-label="Acessar perfil oficial @cineticame no Instagram (abre em nova aba)"
          >
            Acessar Perfil
          </a>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-lg font-bold text-cinetica-blue-deep mb-2 font-heading">
            Localização da Loja Física
          </h3>
          <p class="text-slate-600 text-sm">
            {siteInfo.name}<br />
            {siteInfo.address.city} — {siteInfo.address.state}
          </p>
          <p class="text-xs text-slate-500 mt-3 italic">
            * Canais diretos adicionais (WhatsApp, telefone e e-mail institucional) serão disponibilizados após confirmação formal.
          </p>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

