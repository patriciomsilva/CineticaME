---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteInfo } from '../data/siteInfo';

const title = `Página não encontrada — ${siteInfo.name}`;
const description = 'A página solicitada não foi encontrada. Verifique o endereço digitado ou navegue pelas seções institucionais da Cinética Materiais Elétricos.';
---

<BaseLayout title={title} description={description}>
  <!-- Topo Visual Institucional em Azul Profundo -->
  <section class="relative overflow-hidden bg-cinetica-blue-dark text-white">
    <div class="container-shell py-16 text-center lg:py-24">
      
      <!-- Eyebrow -->
      <div class="flex justify-center mb-6">
        <p class="eyebrow eyebrow-dark">Rota Não Encontrada</p>
      </div>

      <!-- Elemento Visual / 404 Técnico -->
      <div class="flex justify-center mb-8" aria-hidden="true">
        <div class="relative flex h-28 w-28 items-center justify-center rounded-sm border border-white/20 bg-cinetica-blue-deep text-cinetica-orange shadow-2xl sm:h-32 sm:w-32">
          <span class="font-heading text-5xl font-extrabold sm:text-6xl">404</span>
          <div class="absolute -bottom-2 -right-2 bg-cinetica-orange px-2 py-0.5 font-heading text-xs font-extrabold uppercase text-cinetica-blue-dark">
            Erro
          </div>
        </div>
      </div>

      <!-- Título Principal Único (h1) -->
      <h1 class="display-title max-w-2xl mx-auto">
        Página não encontrada
      </h1>

      <!-- Explicação Sucinta -->
      <p class="mt-6 max-w-xl mx-auto text-lg leading-relaxed text-slate-300">
        O endereço solicitado pode ter sido alterado, removido ou digitado incorretamente.
      </p>

    </div>
  </section>

  <!-- Seção de Atalhos Institucionais e Navegação Alternativa -->
  <section class="bg-[var(--color-paper)] py-16 sm:py-20 lg:py-24">
    <div class="container-shell max-w-5xl text-center">
      
      <!-- Subtítulo Hierárquico Semântico (h2) -->
      <p class="eyebrow mb-3">Navegação Alternativa</p>
      <h2 class="section-title mb-4">
        Para onde você deseja ir?
      </h2>
      <p class="mx-auto max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg mb-12">
        Selecione uma das seções institucionais abaixo para continuar navegando pela Cinética:
      </p>

      <!-- Grade de Atalhos com Foco Visível e Superfície Editorial -->
      <div class="grid grid-cols-1 gap-5 text-left sm:grid-cols-2 lg:grid-cols-4 mb-12">
        
        <a 
          href="/" 
          class="surface-card group p-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cinetica-orange"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="font-heading text-2xl font-extrabold uppercase text-cinetica-blue-deep transition-colors group-hover:text-cinetica-orange">Início</span>
            <span class="text-slate-400 transition-transform group-hover:translate-x-1 group-hover:text-cinetica-orange font-bold text-lg" aria-hidden="true">→</span>
          </div>
          <p class="text-sm leading-relaxed text-slate-600">Apresentação geral, equipe e principais destaques da Cinética.</p>
        </a>

        <a 
          href="/solucoes" 
          class="surface-card group p-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cinetica-orange"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="font-heading text-2xl font-extrabold uppercase text-cinetica-blue-deep transition-colors group-hover:text-cinetica-orange">Soluções</span>
            <span class="text-slate-400 transition-transform group-hover:translate-x-1 group-hover:text-cinetica-orange font-bold text-lg" aria-hidden="true">→</span>
          </div>
          <p class="text-sm leading-relaxed text-slate-600">Materiais elétricos residenciais, comerciais, industriais e iluminação.</p>
        </a>

        <a 
          href="/a-cinetica" 
          class="surface-card group p-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cinetica-orange"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="font-heading text-2xl font-extrabold uppercase text-cinetica-blue-deep transition-colors group-hover:text-cinetica-orange">A Cinética</span>
            <span class="text-slate-400 transition-transform group-hover:translate-x-1 group-hover:text-cinetica-orange font-bold text-lg" aria-hidden="true">→</span>
          </div>
          <p class="text-sm leading-relaxed text-slate-600">Conheça nossa estrutura física, equipe e atendimento presencial.</p>
        </a>

        <a 
          href="/contato" 
          class="surface-card group p-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cinetica-orange"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="font-heading text-2xl font-extrabold uppercase text-cinetica-blue-deep transition-colors group-hover:text-cinetica-orange">Contato</span>
            <span class="text-slate-400 transition-transform group-hover:translate-x-1 group-hover:text-cinetica-orange font-bold text-lg" aria-hidden="true">→</span>
          </div>
          <p class="text-sm leading-relaxed text-slate-600">WhatsApp, canal oficial no Instagram e localização em Morro da Fumaça.</p>
        </a>

      </div>

      <!-- Botão de Ação Direta Principal -->
      <div>
        <a 
          href="/" 
          class="btn-primary"
        >
          <span>Ir para a Página Inicial</span>
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
