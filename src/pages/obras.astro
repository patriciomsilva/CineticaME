---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Obras — Cinética Materiais Elétricos"
  description="Materiais elétricos para obras residenciais e industriais em Morro da Fumaça — SC."
>
  <section class="bg-cinetica-blue-deep text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="text-cinetica-orange font-bold uppercase tracking-wider text-xs block mb-2">Projetos</span>
        <h1 class="text-4xl sm:text-6xl font-extrabold font-heading mb-4 text-white">
          Obras
        </h1>
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed">
          Materiais elétricos para obras residenciais e industriais em Morro da Fumaça — SC.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 sm:p-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-cinetica-blue-deep font-heading mb-4">
          Galeria de Obras em Atualização
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6 max-w-xl mx-auto">
          Estamos compilando os registros fotográficos e memoriais de fornecimento autorizados para exibição em nosso portal.
        </p>
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-cinetica-orange hover:bg-cinetica-orange-hover text-white text-xs font-bold uppercase tracking-wider px-6 py-3 rounded transition-colors"
        >
          Voltar para a Página Inicial
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

