---
import BaseLayout from '../layouts/BaseLayout.astro';
import { solutionsData } from '../data/solutions';
---

<BaseLayout
  title="Soluções em Materiais Elétricos — Cinética"
  description="Materiais elétricos e iluminação para residências, profissionais e empresas em Morro da Fumaça — SC."
>
  <section class="relative overflow-hidden bg-cinetica-blue-dark text-white">
    <div class="container-shell grid min-h-[520px] items-stretch lg:grid-cols-12">
      <div class="flex flex-col justify-center py-16 lg:col-span-7 lg:pr-14">
        <p class="eyebrow eyebrow-dark mb-6">Soluções Cinética</p>
        <h1 class="display-title">Do primeiro ponto de luz à operação inteira.</h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-300 sm:text-xl">
          Uma seleção de materiais para diferentes etapas, ambientes e níveis de exigência — com atendimento próximo para ajudar na escolha.
        </p>
      </div>
      <div class="image-frame min-h-[320px] lg:col-span-5 lg:-mr-10">
        <picture>
          <source srcset="/assets/images/loja-fachada.avif" type="image/avif" />
          <source srcset="/assets/images/loja-fachada.webp" type="image/webp" />
          <img src="/assets/images/loja-fachada.webp" alt="Fachada da Cinética Materiais Elétricos" width="700" height="875" class="h-full w-full object-cover" fetchpriority="high" />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-t from-cinetica-blue-dark/70 via-transparent to-transparent"></div>
        <p class="absolute bottom-7 left-7 right-7 font-heading text-2xl font-bold uppercase text-white">Loja física em Morro da Fumaça</p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-paper)] py-20 sm:py-24 lg:py-28">
    <div class="container-shell">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-4">Portfólio de atendimento</p>
          <h2 class="section-title">Cinco frentes. Um só compromisso com o seu projeto.</h2>
        </div>
        <p class="text-lg leading-relaxed text-slate-600 lg:col-span-5 lg:pl-8">
          Encontre o caminho mais próximo da sua necessidade. Nossa equipe complementa a escolha no atendimento presencial.
        </p>
      </div>

      <div class="mt-14 grid gap-5 md:grid-cols-2">
        {solutionsData.map((solution, index) => (
          <article id={solution.id} class:list={[
            'surface-card group relative overflow-hidden p-8 sm:p-10',
            index === 0 || index === 3 ? 'bg-cinetica-blue-deep text-white md:min-h-[360px]' : 'md:min-h-[300px]',
            index === 4 && 'md:col-span-2',
          ]}>
            <div class="flex items-start justify-between gap-6">
              <span class:list={['text-xs font-bold uppercase tracking-[0.16em]', index === 0 || index === 3 ? 'text-cyan-100' : 'text-cinetica-blue-navy']}>Solução {solution.categoryNumber}</span>
              <span class:list={['font-heading text-6xl font-extrabold leading-none', index === 0 || index === 3 ? 'text-white/50' : 'text-slate-500']} aria-hidden="true">{solution.categoryNumber}</span>
            </div>
            <div class="mt-16 max-w-xl">
              <h3 class:list={['font-heading text-3xl font-extrabold uppercase leading-none sm:text-4xl', index === 0 || index === 3 ? 'text-white' : 'text-cinetica-blue-deep']}>{solution.title}</h3>
              <p class:list={['mt-5 text-base leading-relaxed', index === 0 || index === 3 ? 'text-slate-300' : 'text-slate-600']}>{solution.description}</p>
            </div>
            <div class="absolute bottom-0 left-0 h-1 w-0 bg-cinetica-orange transition-all duration-500 group-hover:w-full" aria-hidden="true"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-white">
    <div class="container-shell grid lg:grid-cols-12">
      <div class="image-frame min-h-[360px] lg:col-span-5 lg:-ml-10">
        <picture>
          <source srcset="/assets/images/atendimento-balcao.avif" type="image/avif" />
          <source srcset="/assets/images/atendimento-balcao.webp" type="image/webp" />
          <img src="/assets/images/atendimento-balcao.webp" alt="Atendimento presencial no balcão da Cinética" width="700" height="875" loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
        </picture>
      </div>
      <div class="flex flex-col justify-center py-16 lg:col-span-7 lg:py-24 lg:pl-16">
        <p class="eyebrow mb-4">A escolha certa começa no atendimento</p>
        <h2 class="section-title max-w-2xl">Traga sua ideia, sua lista ou sua necessidade.</h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
          Visite a loja ou converse com a Cinética para entender quais materiais fazem sentido para o seu projeto.
        </p>
        <div class="mt-8"><a href="/contato" class="btn-primary">Falar com nossa equipe</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
